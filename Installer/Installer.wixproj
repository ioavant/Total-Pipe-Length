<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" InitialTargets="EnsureWixToolsetInstalled" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- A .wixproj does not import Microsoft.Common.props, so Directory.Build.props
       has to be pulled in by hand; it is what defines $(Brand) and everything the
       branding engine derives from it. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props"
          Condition=" '$(_BrandingPropsImported)' != 'true' " />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <!-- x64: in an x86 package ProgramFiles64Folder resolves to Program Files (x86),
         which is not where Revit 2027 looks for add-in manifests. -->
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProductVersion>3.10</ProductVersion>
    <ProjectGuid>187DA3D7-C9F8-43D2-A088-7A326E24554B</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>TotalPipeLengthSetup_$(Brand)</OutputName>
    <OutputType>Package</OutputType>
    <!-- ICE61 fires because MajorUpgrade/@AllowSameVersionUpgrades makes the
         upgrade range overlap this product's own version. That overlap is the
         point - see the comment in Product.wxs. -->
    <SuppressIces>ICE61</SuppressIces>
    <DefineSolutionProperties>false</DefineSolutionProperties>
  </PropertyGroup>
  <!-- Brand-scoped so both MSIs can be built back to back. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\$(Configuration)\$(Brand)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(Brand)\</IntermediateOutputPath>
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\$(Configuration)\$(Brand)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(Brand)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="WixUIExtension">
      <HintPath>$(WixExtDir)\WixUIExtension.dll</HintPath>
      <Name>WixUIExtension</Name>
    </WixExtension>
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned to one TFM: a .wixproj is not SDK-aware and cannot negotiate a
         target framework with a multi-targeted project, so it would ask the outer
         build for GetTargetPath (only inner builds define it) and fail with
         MSB4057. Both frameworks are still built by the csproj's own solution node;
         this reference only orders the two builds. Product.wxs sources each DLL by
         absolute path from brand.generated.wxi, not from this reference's outputs. -->
    <ProjectReference Include="..\Total Pipe Length\TotalPipeLength.csproj">
      <Name>TotalPipeLength</Name>
      <Project>{DEB4566D-FEA6-4D1F-BDD8-832D5188B5D8}</Project>
      <Private>True</Private>
      <DoNotHarvest>True</DoNotHarvest>
      <RefProjectOutputGroups>Binaries;Content;Satellites</RefProjectOutputGroups>
      <RefTargetDir>INSTALLFOLDER</RefTargetDir>
      <AdditionalProperties>TargetFramework=net48</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(WixTargetsPath)" Condition=" '$(WixTargetsPath)' != '' " />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets" Condition=" '$(WixTargetsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets') " />
  <Target Name="EnsureWixToolsetInstalled" Condition=" '$(WixTargetsImported)' != 'true' ">
    <Error Text="The WiX Toolset v3.11 build tools must be installed to build this project. To download the WiX Toolset, see https://wixtoolset.org/releases/v3.11/stable" />
  </Target>
  <!-- Generates the .addin manifests and brand.generated.wxi this project compiles. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets"
          Condition=" '$(_BrandingTargetsImported)' != 'true' " />
</Project>
